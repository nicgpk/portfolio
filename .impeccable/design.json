  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Pill work action with semantic default and white-on-black opening variant.",
      "html": "<a class=\"ds-primary\" href=\"#\">View my work</a><div class=\"ds-opening-action\"><a class=\"ds-primary ds-hero-action\" href=\"#\">View my work</a></div>",
      "css": ".ds-primary{display:inline-flex;align-items:center;min-height:48px;padding:12px 26px;background:var(--text,#101010);color:var(--bg,#fff);border-radius:999px;text-decoration:none;font:500 15px 'IBM Plex Sans',sans-serif}.ds-primary:hover{background:var(--accent,#a82412)}.ds-primary:focus-visible{outline:3px solid var(--accent,#a82412);outline-offset:5px}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color .18s ease}.ds-primary:active{transform:scale(.98)}}.ds-opening-action{background:#080808;padding:24px;margin-top:16px}.ds-hero-action{background:#fff;color:#101010;border:1px solid #fff}.ds-hero-action:hover{background:#ffb39f;border-color:#ffb39f}"
    },
    {
      "name": "Glass artifact frame",
      "kind": "custom",
      "description": "Existing source case screenshots retain unobscured supporting frames; new operating canvases use tonal separation.",
      "html": "<figure class=\"ds-artifact\"><p>Original product artifact</p><figcaption>Project context</figcaption></figure>",
      "css": ".ds-artifact{background:var(--glass-solid,#fff);color:var(--text,#101010);padding:12px;border-radius:20px;border:1px solid var(--glass-edge,rgba(255,255,255,.88));box-shadow:var(--glass-shadow,0 16px 48px rgba(31,49,75,.1));font-family:'IBM Plex Sans',sans-serif}.ds-artifact figcaption{font-size:13px;color:var(--text-muted,#4b4b4b)}@supports(backdrop-filter:blur(1px)){.ds-artifact{background:var(--glass-fill,rgba(255,255,255,.86));backdrop-filter:blur(14px)}}@media(prefers-reduced-transparency:reduce){.ds-artifact{background:var(--glass-solid,#fff);backdrop-filter:none}}"
    },
    {
      "name": "Text link",
      "kind": "button",
      "description": "Secondary navigation action.",
      "html": "<a class=\"ds-link\" href=\"#\">Resume</a>",
      "css": ".ds-link{display:inline-flex;align-items:center;min-height:44px;font:400 15px 'IBM Plex Sans',sans-serif;color:var(--text,#101010);text-underline-offset:.25em;text-decoration:underline;text-decoration-color:var(--border-strong,#929292)}.ds-link:hover{color:var(--accent,#a82412)}.ds-link:focus-visible{outline:3px solid var(--accent,#a82412);outline-offset:5px}"
    },
    {
      "name": "Primary navigation",
      "kind": "nav",
      "description": "Persistent About, Projects, Resume navigation.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><a href=\"#\" aria-current=\"page\">About</a><a href=\"#\">Projects</a><a href=\"#\">Resume</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:32px;min-height:64px;padding:0 24px;background:var(--glass-solid,#fff);border:1px solid var(--glass-edge,rgba(255,255,255,.88));border-radius:20px;box-shadow:var(--glass-shadow,0 16px 48px rgba(31,49,75,.1))}.ds-nav a{display:flex;align-items:center;min-height:44px;font:400 15px 'IBM Plex Sans',sans-serif;color:var(--text,#101010);text-decoration:none}.ds-nav a[aria-current],.ds-nav a:hover{color:var(--accent,#a82412)}.ds-nav a:focus-visible{outline:3px solid var(--accent,#a82412);outline-offset:5px}@supports(backdrop-filter:blur(1px)){.ds-nav{background:var(--glass-fill,rgba(255,255,255,.86));backdrop-filter:blur(22px) saturate(130%)}}@media(prefers-reduced-transparency:reduce){.ds-nav{background:var(--glass-solid,#fff);backdrop-filter:none}}@media(max-width:767px){.ds-nav{min-height:60px;padding-inline:16px;gap:14px;border-radius:16px}.ds-nav a{font-size:13px}}@media(prefers-reduced-motion:no-preference){.ds-nav a{transition:color .18s ease}}",
      "refersTo": "navigation"
    },
    {
      "name": "Evidence disclosure",
      "kind": "custom",
      "description": "Native, keyboard-operable access to deeper case evidence.",
      "html": "<details class=\"ds-evidence\"><summary>View supporting evidence</summary><div class=\"ds-evidence-body\">Original product evidence and labeled reconstructions.</div></details>",
      "css": ".ds-evidence{border-block:1px solid var(--border,#d6d6d6);margin:20px 0;color:var(--text,#101010);font-family:\"IBM Plex Sans\",sans-serif}.ds-evidence>summary{padding:18px 4px;min-height:56px;font-size:17px;font-weight:500;cursor:pointer;list-style-position:inside}.ds-evidence>summary:hover{color:var(--accent,#a82412)}.ds-evidence>summary:focus-visible{outline:3px solid var(--accent,#a82412);outline-offset:5px}.ds-evidence-body{padding:12px 0 24px}@media(max-width:767px){.ds-evidence>summary{font-size:16px;padding-block:16px}}"
    },
    {
      "name": "Partner hero and program discovery",
      "kind": "input",
      "description": "Red three-program Partner hero plus distinct selected-work search preview; native details work without JavaScript.",
      "html": "<section class=\"ds-partner-hero\"><div class=\"ds-partner-copy\"><h2>Partner Growth Programs</h2><p>One experience across eight programs.</p><small>Updated interface concept based on the original project.</small></div><div class=\"ds-growth\"><strong>Partner growth</strong><h3>Find the right next step.</h3><details open><summary>Promotions</summary><p>Property sets a discount - Agoda adds a deal badge, boosts rank, and amplifies across email, push, and deal pages.</p></details><details><summary>Agoda Growth Program</summary><p>Pay a higher commission - Agoda deploys the full marketing suite: ranking boost, ad spend, Preferred Partner badge.</p></details><details><summary>Agoda Advanced</summary><p>Pay upfront - Agoda deducts from the balance per booking. AGP or Maximum Gain variant.</p></details></div><p class=\"ds-caption\">Visual exploration · Program selection</p></section><section class=\"ds-program-canvas\"><span class=\"ds-canvas-title\" aria-hidden=\"true\">Partner Growth</span><div class=\"ds-growth ds-work-growth\"><label>Search programs<input disabled type=\"search\" placeholder=\"Try visibility or promotions\"></label><details><summary>Promotions</summary><p>Property sets a discount; Agoda adds a deal badge.</p></details></div><p class=\"ds-caption\">Updated interface concept based on the original project.</p></section>",
      "css": ".ds-growth{font-family:'IBM Plex Sans',sans-serif;font-size:14px;line-height:1.45;border-radius:12px;padding:24px;background:#fff;color:#151515}.ds-growth input{display:block;background:#fff;color:#151515;border:1px solid #dadada;border-radius:8px;padding:11px 14px;margin:6px 0 20px}.ds-growth summary{padding:16px 0;border-block:1px solid #dadada;cursor:pointer}.ds-growth summary:hover{text-decoration:underline}.ds-growth summary:focus-visible{outline:3px solid #3b78c8;outline-offset:3px}.ds-partner-hero,.ds-program-canvas{background:#cf3218;color:#fff;padding:32px;font-family:\"IBM Plex Sans\",sans-serif}.ds-partner-hero{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px;border-radius:12px}.ds-partner-copy h2{font-size:clamp(32px,5.5vw,64px);font-weight:500;line-height:1.04;letter-spacing:-.035em;margin:0 0 24px}.ds-partner-copy p{font-size:18px}.ds-partner-copy small{display:block;font-size:12px;margin-top:32px}.ds-partner-hero .ds-growth{margin-top:48px;border-radius:8px}.ds-growth h3{font-size:27px;font-weight:500}.ds-growth input{border-color:#bdbdbd}.ds-growth input:focus-visible{outline:3px solid #3b78c8;outline-offset:3px}.ds-growth summary:active{color:#a72a16}.ds-caption{font-size:12px;grid-column:1/-1}.ds-program-canvas{margin-top:24px}.ds-canvas-title{display:block;font-size:clamp(40px,7.6vw,80px);font-weight:600;line-height:.95;letter-spacing:-.04em;text-transform:uppercase;margin-bottom:36px}.ds-work-growth{width:82%;margin-left:auto;box-shadow:0 20px 48px rgba(0,0,0,.15);border-radius:8px}@media(max-width:767px){.ds-partner-hero{display:block;border-radius:0;padding:32px 24px}.ds-partner-hero .ds-growth{margin-top:32px}.ds-program-canvas{padding:32px 24px}.ds-work-growth{width:auto;box-shadow:none}}@media(prefers-reduced-transparency:reduce){.ds-partner-hero{background:#cf3218!important}.ds-partner-copy h2{color:#fff!important}}"
    },
    {
      "name": "Sequential rate receipt",
      "kind": "custom",
      "description": "Static sample receipt; portfolio controls update the sequential discounts locally.",
      "html": "<section class=\"ds-receipt\"><p>Calculation</p><dl><div><dt>Room rate</dt><dd>$150.00</dd></div><div><dt>Mega Sale - 15%</dt><dd>-$22.50</dd></div><div><dt>Mobile Exclusive - 10%</dt><dd>-$12.75</dd></div></dl><p>Net rate</p><strong>$114.75</strong><p>Illustrative calculation. No promotion is saved.</p></section>",
      "css": ".ds-receipt{font-family:'IBM Plex Sans',sans-serif;font-size:14px;line-height:1.45;border-radius:12px;padding:24px;background:#f1f2f9;color:#21253e}.ds-receipt dl>div{display:flex;justify-content:space-between;padding:12px 0;font-size:13px}.ds-receipt dd{margin:0;font-variant-numeric:tabular-nums}.ds-receipt strong{font-size:44px;line-height:1.1;font-weight:500;letter-spacing:-.04em;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Developer step identity",
      "kind": "custom",
      "description": "Static preview of anchored service identity and step controls awaiting enhancement.",
      "html": "<section class=\"ds-developer\"><strong>devops-safe-app</strong><p>staging-mesh · Draft example</p><div><button disabled aria-pressed=\"true\">1 Environment</button><button disabled aria-pressed=\"false\">2 Rollout</button><button disabled aria-pressed=\"false\">3 Review</button></div><p>Environment setup</p><p>Visual exploration; sample values.</p></section>",
      "css": ".ds-developer{font-family:'IBM Plex Sans',sans-serif;font-size:14px;line-height:1.45;border-radius:12px;padding:24px;background:#17212a;color:#f0f3f7}.ds-developer>strong{font-size:20px;font-weight:500}.ds-developer p{color:#aeb9c7;font-size:12px}.ds-developer button{background:transparent;color:#b4bfcd;border:0;border-bottom:2px solid transparent;min-height:44px;padding:0 8px;font:12px \"IBM Plex Sans\",sans-serif}.ds-developer button[aria-pressed=true]{color:#fff;border-bottom-color:#abd4fa}.ds-developer button:enabled:hover{color:#fff}.ds-developer button:focus-visible{outline:3px solid #3b78c8;outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "High contrast, working evidence",
    "overview": "A stark black opening and oversized white IBM Plex Sans establish a confident editorial identity. Vivid red, violet and blue fields give existing project content dramatic scale; asymmetric operating surfaces make each project feel authored. Glass supports navigation and preserved source artifact frames without setting the visual ceiling.\n\nThe owner rejected the muted, safe pass and pinned Tobias van Schneider as a reference. The current direction takes contrast, conviction and scale from that reference while using existing content and artifacts. Updated interface concepts are labeled, original designs remain linked, and factual project evidence stays qualified.",
    "keyCharacteristics": [
      "Oversized uppercase role typography on a black opening.",
      "A vivid red Partner Growth hero and distinct full-width project fields.",
      "Asymmetric operating surfaces beside large visual project titles.",
      "Purposeful, interruptible motion with live reduced-motion cancellation."
    ],
    "rules": [
      {
        "name": "The Conviction Rule",
        "body": "Preserve the vivid project fields and stark opening established by the owner's correction; do not soften them into the rejected muted world.",
        "section": "colors"
      },
      {
        "name": "The Evidence Hierarchy Rule",
        "body": "Large visual titles establish project identity; semantic headings, decisions and qualified evidence carry the readable case story.",
        "section": "typography"
      },
      {
        "name": "The Supporting Glass Rule",
        "body": "Glass belongs to navigation and existing artifact framing; vivid project fields carry the presentation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain decisive contrast and independently colored project fields.",
      "Do label interface explorations and keep original designs accessible.",
      "Do keep controls keyboard accessible and respect live reduced-motion changes.",
      "Do preserve qualified ownership, project facts and existing source assets."
    ],
    "donts": [
      "Don't return to the muted palette rejected by the owner.",
      "Don't replace the Partner Growth hero with Developer Portal.",
      "Don't invent outcomes, research, testimonials or shipped redesign claims.",
      "Don't obscure source screenshots with glass or import reference-site assets."
    ]
  }
}
